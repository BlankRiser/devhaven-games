{
  "name": "dev-games",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "frontend": "bun --filter frontend",
    "backend": "bun --filter backend",
    "build": "bun --filter '*' build",
    "build:frontend": "bun --filter frontend build",
    "build:backend": "bun --filter backend build",
    "test:multiplayer": "bun --filter backend test:multiplayer",
    "lint": "bun --filter '*' lint",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "stylelint": "^17.0.0",
    "typescript": "^5",
    "ultracite": "8.0.0"
  },
  "packageManager": "bun@1.3.11",
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
